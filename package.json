{
  "private": true,
  "type": "module",
  "scripts": {
    "build:demo": "ng build demo",
    "build:lib": "ng build ngx-editor",
    "build": "npm run build:lib && npm run build:demo",
    "postbuild:lib": "node ./scripts/postbuild.js",
    "dev": "ng build ngx-editor --watch --configuration development",
    "demo": "ng serve demo --port 5002 --configuration development",
    "serve:ssr:demo": "node dist/demo/server/server.mjs",
    "ng": "ng",
    "lint": "ng lint",
    "format:md": "prettier **/*.md --write",
    "test:demo": "ng test demo --watch false",
    "test:lib": "ng test ngx-editor --watch false",
    "test": "npm run test:lib && npm run test:demo",
    "prepare": "is-ci || husky"
  },
  "engines": {
    "node": "^22.22.3 || >=24.15.0",
    "npm": ">=10"
  },
  "keywords": [
    "angular-editor",
    "angular-wysiwyg-editor",
    "wysiwyg-editor",
    "ngx-editor",
    "prosemirror",
    "angular-prosemirror",
    "angular-rich-text-editor",
    "angular-rte"
  ],
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-server": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@angular/ssr": "^22.2.1",
    "express": "^5.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@floating-ui/core": "^1.8.0",
    "@floating-ui/dom": "^1.8.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.15.0",
    "@types/trusted-types": "~2.0.7",
    "angular-eslint": "^22.5.0",
    "codemirror": "^6.0.2",
    "eslint": "^9.39.5",
    "eslint-config-pegasus": "^6.0.2",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "ng-packagr": "^22.2.4",
    "picocolors": "^1.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prosemirror-codemirror-6": "^1.0.1",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-view": "^1.42.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
